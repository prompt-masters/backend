HOST=0.0.0.0
PORT=8080

# Host ports published by docker compose. Change these if something else on
# your machine already owns 8080 or 5432.
APP_PORT=8080
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:password@localhost:5432/prompters_db?sslmode=disable
JWT_SECRET=change-me-in-production
# Access token lifetime, parsed as a Go duration (e.g. 24h, 30m).
JWT_TTL=15m
# Long-lived session token lifetime, parsed as a Go duration.
REFRESH_TOKEN_TTL=720h

# Redis holds live game state. REDIS_PASSWORD is required by docker compose.
REDIS_ADDR=localhost:6379
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_TLS=false
# Optional: verify the server against a private CA instead of the system roots.
REDIS_TLS_CA_FILE=
REDIS_TLS_SERVER_NAME=
REDIS_POOL_SIZE=20
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
# Upper bound for each live-state operation.
REDIS_OP_TIMEOUT=2s
REDIS_KEY_PREFIX=promptgame
# Sliding expiry for waiting/in-progress games, and expiry once a game ends.
GAME_STATE_ACTIVE_TTL=2h
GAME_STATE_ENDED_TTL=15m

# WebSocket hub. Origins are a comma-separated allowlist; same-origin requests
# and non-browser clients (no Origin header) are always allowed.
WS_ALLOWED_ORIGINS=http://localhost:5173
WS_PING_INTERVAL=30s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s
# Outbound queue per connection; a client that fills it is disconnected.
WS_SEND_BUFFER=64
WS_MAX_MESSAGE_BYTES=16384
WS_MAX_CONNECTIONS_PER_USER=3

# Redis used by tests. Use a separate DB index from development.
TEST_REDIS_ADDR=localhost:6379
TEST_REDIS_PASSWORD=change-me
TEST_REDIS_DB=15

TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/prompters_test_db?sslmode=disable

# Public origin used to build verification links.
APP_BASE_URL=http://localhost:8080

# SMTP. Leave MAIL_HOST empty to have verification links written to the
# server log instead of emailed, which is usually what you want locally.
# For Gmail, MAIL_PASSWORD must be an app password, not the account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=

# AI layer. Off unless AI_ENABLED=true; when on, startup fails if a provider in
# use has no <PROVIDER>_API_KEY. Keys come only from the environment or your
# secret manager - never commit them.
AI_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional endpoint overrides (e.g. a gateway).
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
# Executor runs player prompts; judge scores them. Provider names: anthropic, openai.
AI_EXECUTOR_PROVIDER=anthropic
AI_EXECUTOR_MODEL=claude-opus-5
AI_EXECUTOR_TIMEOUT=60s
AI_EXECUTOR_MAX_TOKENS=4096
AI_JUDGE_PROVIDER=anthropic
AI_JUDGE_MODEL=claude-opus-5
AI_JUDGE_TIMEOUT=90s
AI_JUDGE_MAX_TOKENS=8192
# Leave temperatures unset for current Claude models (Opus 5, Sonnet 5), which
# reject the parameter.
AI_EXECUTOR_TEMPERATURE=
AI_JUDGE_TEMPERATURE=
# Each game's ai_model setting -> provider/model that plays it.
AI_EXECUTOR_MODELS=claude-opus-5=anthropic/claude-opus-5,claude-sonnet-5=anthropic/claude-sonnet-5,claude-haiku-4-5=anthropic/claude-haiku-4-5
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY=250ms
AI_RETRY_MAX_DELAY=4s
# Client-side limits per provider: provider=requests_per_second:burst
AI_RATE_LIMITS=anthropic=5:10,openai=5:10
# USD per million tokens: model=input:output. Unlisted models report no cost.
AI_PRICING=claude-opus-5=5:25,claude-sonnet-5=2:10,claude-haiku-4-5=1:5
AI_JUDGE_PARSE_RETRIES=1
# Logs prompts and responses. Debugging only; never in production.
AI_LOG_CONTENT=false
