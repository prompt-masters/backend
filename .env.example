HOST=0.0.0.0
PORT=8080

# Host ports published by docker compose. Change these if something else on
# your machine already owns 8080 or 5432.
APP_PORT=8080
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:password@localhost:5432/prompters_db?sslmode=disable
JWT_SECRET=change-me-in-production

TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/prompters_test_db?sslmode=disable

# Public origin used to build verification links.
APP_BASE_URL=http://localhost:8080

# SMTP. Leave MAIL_HOST empty to have verification links written to the
# server log instead of emailed, which is usually what you want locally.
# For Gmail, MAIL_PASSWORD must be an app password, not the account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
